{
    "name": "theme-scheduler",
    "displayName": "Theme Scheduler",
    "version": "1.0.0",
    "author": "NsnDev",
    "description": "Automatically switch themes based on time of day",
    "hooks": [
        "onDiscordStart"
    ],
    "config": {
        "enabled": false,
        "schedules": [
            {
                "theme": "dark-purple",
                "startTime": "18:00",
                "endTime": "06:00"
            },
            {
                "theme": "light-minimal",
                "startTime": "06:00",
                "endTime": "18:00"
            }
        ]
    },
    "dependencies": []
}